# GoogleAc Webapp — environment variables
#
# Copy this file to .env (already in .gitignore) and fill in your own values.
# Never commit .env — it contains secrets.
#
# ── Google OAuth 2.0 (Web Application client) ────────────────────────────────
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a "Web Application" OAuth 2.0 Client ID
# 3. Add http://localhost:3000/auth/callback as an Authorized Redirect URI
# 4. Paste the generated client_id and client_secret below
#
OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET

# ── Session ──────────────────────────────────────────────────────────────────
# A long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
