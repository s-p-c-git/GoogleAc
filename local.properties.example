# local.properties.example
#
# Copy this file to local.properties (already in .gitignore) and fill in your
# own values.  Never commit local.properties — it contains secrets.
#
# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an Android OAuth client ID for package name  com.googleac.app
# 3. Paste the generated client ID below (format: <numbers>.apps.googleusercontent.com)
#
oauth.client_id=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com

# ── Android SDK (auto-generated by Android Studio) ───────────────────────────
# sdk.dir=/path/to/your/Android/sdk
