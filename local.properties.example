# local.properties.example
#
# Copy this file to local.properties (already in .gitignore) and fill in your
# own values.  Never commit local.properties — it contains secrets.
#
# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an Android OAuth client ID for package name  com.googleac.app
# 3. Paste the generated client ID below (format: <numbers>.apps.googleusercontent.com)
#
oauth.client_id=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com

# ── Android SDK (auto-generated by Android Studio) ───────────────────────────
# sdk.dir=/path/to/your/Android/sdk

# ── Release APK signing ───────────────────────────────────────────────────────
#
# Required only when building a signed release APK for distribution.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -alias googleac \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then set the four properties below.  The keystore file itself must never be
# committed to version control.
#
# release.store.file=/absolute/path/to/release.jks
# release.store.password=REPLACE_WITH_KEYSTORE_PASSWORD
# release.key.alias=googleac
# release.key.password=REPLACE_WITH_KEY_PASSWORD
#
# Build a signed release APK:
#   ./gradlew assembleRelease
# The APK is output to:  app/build/outputs/apk/release/app-release.apk
#
# Build a debug APK (no signing config required, uses Android debug keystore):
#   ./gradlew assembleDebug
# The debug APK is output to:  app/build/outputs/apk/debug/app-debug.apk
